@article{kim_polymer_2021,
	title = {Polymer design using genetic algorithm and machine learning},
	volume = {186},
	issn = {0927-0256},
	url = {https://www.sciencedirect.com/science/article/pii/S0927025620305589},
	doi = {10.1016/j.commatsci.2020.110067},
	abstract = {Data driven or machine learning ({ML}) based methods have been recently used in materials science to provide quick material property predictions. Although powerful and robust, these predictive models are still limited in terms of their applicability towards the design of materials with target property or performance objectives. Here, we employ a nature-mimicking optimization method, the genetic algorithm, in tandem with {ML}-based predictive models to design polymers that meet practically useful, but extreme, property criteria (i.e., glass transition temperature, Tg{\textgreater}500 K and bandgap, Eg{\textgreater}6 {eV}). Analogous to nature, the characteristic properties of a polymer are assumed to be determined by the constituting types and sequence of chemical building blocks (or fragments) in the monomer unit. Evolution of polymers by natural operations of crossover, mutation, and selection over 100 generations leads to creation of 132 new (as compared to 4 already known cases) and chemically unique polymers with high Tg and Eg. Chemical guidelines on what fragments make up polymers with extreme thermal and electrical performance metrics have been selected and revealed by the algorithm. The approach presented here is general and can be extended to design polymers with different property objectives.},
	pages = {110067},
	journal = {Computational Materials Science},
	author = {Kim, Chiho and Batra, Rohit and Chen, Lihua and Tran, Huan and Ramprasad, Rampi},
	year = {2021},
	month = jan,
	keywords = {Bandgap, Genetic algorithm, Glass transition temperature, Machine learning, Polymer},
}

@article{huan_polymer_2016,
	title = {A polymer dataset for accelerated property prediction and design},
	volume = {3},
	issn = {2052-4463},
	url = {https://doi.org/10.1038/sdata.2016.12},
	doi = {10.1038/sdata.2016.12},
	abstract = {Emerging computation- and data-driven approaches are particularly useful for rationally designing materials with targeted properties. Generally, these approaches rely on identifying structure-property relationships by learning from a dataset of sufficiently large number of relevant materials. The learned information can then be used to predict the properties of materials not already in the dataset, thus accelerating the materials design. Herein, we develop a dataset of 1,073 polymers and related materials and make it available at http://khazana.uconn.edu/. This dataset is uniformly prepared using first-principles calculations with structures obtained either from other sources or by using structure search methods. Because the immediate target of this work is to assist the design of high dielectric constant polymers, it is initially designed to include the optimized structures, atomization energies, band gaps, and dielectric constants. It will be progressively expanded by accumulating new materials and including additional properties calculated for the optimized structures provided.},
	pages = {160012},
	number = {1},
	journal = {Scientific Data},
	author = {Huan, Tran Doan and Mannodi-Kanakkithodi, Arun and Kim, Chiho and Sharma, Vinit and Pilania, Ghanshyam and Ramprasad, Rampi},
	year = {2016},
	month = mar,
}

